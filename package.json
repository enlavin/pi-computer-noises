{
  "name": "popcorn-popper",
  "version": "1.0.0",
  "description": "Agent ambience for pi and opencode: popcorn-popper (microwave drone + pops + ding) and computer-noises (retro mainframe hum + data blips). Each is a single shared instance across all agents.",
  "keywords": ["pi-package", "opencode-plugin"],
  "type": "module",
  "license": "MIT",
  "main": "./plugin/popcorn.ts",
  "exports": {
    ".": "./plugin/popcorn.ts",
    "./popcorn": "./plugin/popcorn.ts",
    "./computer-noises": "./plugin/computer-noises.ts"
  },
  "files": ["src", "extensions", "plugin", "assets", "README.md"],
  "pi": {
    "extensions": ["extensions"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@opencode-ai/plugin": "*",
    "@types/node": "*"
  }
}
